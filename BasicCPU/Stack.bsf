(header "symbol" (version "1.1"))
(symbol
	(rect 16 16 264 160)
	(text "Stack" (rect 5 0 27 12)(font "Arial" ))
	(text "inst" (rect 8 128 20 140)(font "Arial" ))
	(port
		(pt 0 32)
		(input)
		(text "Clk" (rect 0 0 12 12)(font "Arial" ))
		(text "Clk" (rect 21 27 33 39)(font "Arial" ))
		(line (pt 0 32)(pt 16 32)(line_width 1))
	)
	(port
		(pt 0 48)
		(input)
		(text "Reset" (rect 0 0 24 12)(font "Arial" ))
		(text "Reset" (rect 21 43 45 55)(font "Arial" ))
		(line (pt 0 48)(pt 16 48)(line_width 1))
	)
	(port
		(pt 0 64)
		(input)
		(text "Enable" (rect 0 0 27 12)(font "Arial" ))
		(text "Enable" (rect 21 59 48 71)(font "Arial" ))
		(line (pt 0 64)(pt 16 64)(line_width 1))
	)
	(port
		(pt 0 80)
		(input)
		(text "Push" (rect 0 0 20 12)(font "Arial" ))
		(text "Push" (rect 21 75 41 87)(font "Arial" ))
		(line (pt 0 80)(pt 16 80)(line_width 1))
	)
	(port
		(pt 0 96)
		(input)
		(text "Pop" (rect 0 0 15 12)(font "Arial" ))
		(text "Pop" (rect 21 91 36 103)(font "Arial" ))
		(line (pt 0 96)(pt 16 96)(line_width 1))
	)
	(port
		(pt 0 112)
		(input)
		(text "Data_In[(dw-1)..0]" (rect 0 0 70 12)(font "Arial" ))
		(text "Data_In[(dw-1)..0]" (rect 21 107 91 119)(font "Arial" ))
		(line (pt 0 112)(pt 16 112)(line_width 3))
	)
	(port
		(pt 248 32)
		(output)
		(text "Data_Out[(dw-1)..0]" (rect 0 0 77 12)(font "Arial" ))
		(text "Data_Out[(dw-1)..0]" (rect 150 27 227 39)(font "Arial" ))
		(line (pt 248 32)(pt 232 32)(line_width 3))
	)
	(port
		(pt 248 48)
		(output)
		(text "Full" (rect 0 0 12 12)(font "Arial" ))
		(text "Full" (rect 215 43 227 55)(font "Arial" ))
		(line (pt 248 48)(pt 232 48)(line_width 1))
	)
	(port
		(pt 248 64)
		(output)
		(text "Empty" (rect 0 0 28 12)(font "Arial" ))
		(text "Empty" (rect 199 59 227 71)(font "Arial" ))
		(line (pt 248 64)(pt 232 64)(line_width 1))
	)
	(parameter
		"DW"
		"16"
		""
		(type "PARAMETER_SIGNED_DEC")	)
	(parameter
		"DEPTH"
		"10"
		""
		(type "PARAMETER_SIGNED_DEC")	)
	(drawing
		(rectangle (rect 16 16 232 128)(line_width 1))
	)
	(annotation_block (parameter)(rect 264 -64 364 16))
)
