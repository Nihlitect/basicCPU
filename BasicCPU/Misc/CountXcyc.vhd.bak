library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity CountXcyc is
    generic (
		X: integer := 512;
    );
    port (
        clk     : in  std_logic;
        RESET   : in  std_logic;
        CR: out std_logic -- Count reached
    );
end entity CountXsec;

architecture rtl of CountXsec is
    -- Max count for 3 seconds = 3 * CLK_FREQ
    signal count : integer range 0 to MAX_COUNT := 0;
    signal out_reg : std_logic := '0';
begin

	process(clk, reset)
	begin
		if reset = '1' then
			count <= 0;
			out_reg <= '0';
		elsif rising_edge(clk) then
			if count < X then
				count <= count + 1;
				out_reg <= '0';
			else
				out_reg <= '1'; -- Goes high after X clock cycles
				-- Keep count at X
			end if;
		end if;
	end process;
	CR <= out_reg;
end architecture rtl;