library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity Count3sec is
    generic (
        CLK_FREQ : integer := 50 000 000
    );
    port (
		
        clk     : in  std_logic;
        RESET   : in  std_logic;
        CR: out std_logic -- Count reached
    );
end entity Count3sec;

architecture rtl of Count3sec is
    -- Max count for 3 seconds = 3 * CLK_FREQ
    constant MAX_COUNT : integer := 3 * CLK_FREQ;
    signal count : integer range 0 to MAX_COUNT := 0;
    signal out_reg : std_logic := '0';
begin

    process(clk, reset)
    begin
        if reset = '1' then
            count <= 0;
            out_reg <= '0';
			
        elsif rising_edge(clk) then
            if count < MAX_COUNT then
                count <= count + 1;
                out_reg <= '0';
            else
                out_reg <= '1'; -- Goes high after 3 seconds
                -- Keep count at MAX_COUNT
            end if;
				
        end if;
		  
    end process;

    output_high <= out_reg;

end architecture rtl;