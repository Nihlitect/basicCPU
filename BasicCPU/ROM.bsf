(header "symbol" (version "1.1"))
(symbol
	(rect 16 16 288 128)
	(text "ROM" (rect 5 0 28 12)(font "Arial" ))
	(text "inst" (rect 8 96 20 108)(font "Arial" ))
	(port
		(pt 0 32)
		(input)
		(text "ADDR[(a_width-1)..0]" (rect 0 0 88 12)(font "Arial" ))
		(text "ADDR[(a_width-1)..0]" (rect 21 27 109 39)(font "Arial" ))
		(line (pt 0 32)(pt 16 32)(line_width 3))
	)
	(port
		(pt 0 48)
		(input)
		(text "clk" (rect 0 0 10 12)(font "Arial" ))
		(text "clk" (rect 21 43 31 55)(font "Arial" ))
		(line (pt 0 48)(pt 16 48)(line_width 1))
	)
	(port
		(pt 0 64)
		(input)
		(text "EN" (rect 0 0 14 12)(font "Arial" ))
		(text "EN" (rect 21 59 35 71)(font "Arial" ))
		(line (pt 0 64)(pt 16 64)(line_width 1))
	)
	(port
		(pt 272 32)
		(output)
		(text "Dout[(d_width-1)..0]" (rect 0 0 76 12)(font "Arial" ))
		(text "Dout[(d_width-1)..0]" (rect 175 27 251 39)(font "Arial" ))
		(line (pt 272 32)(pt 256 32)(line_width 3))
	)
	(port
		(pt 272 48)
		(output)
		(text "DoutI[(d_width-1)..0]" (rect 0 0 79 12)(font "Arial" ))
		(text "DoutI[(d_width-1)..0]" (rect 172 43 251 55)(font "Arial" ))
		(line (pt 272 48)(pt 256 48)(line_width 3))
	)
	(parameter
		"D_WIDTH"
		"16"
		""
		(type "PARAMETER_SIGNED_DEC")	)
	(parameter
		"A_WIDTH"
		"16"
		""
		(type "PARAMETER_SIGNED_DEC")	)
	(parameter
		"SIZE"
		"128"
		""
		(type "PARAMETER_SIGNED_DEC")	)
	(drawing
		(rectangle (rect 16 16 256 96)(line_width 1))
	)
	(annotation_block (parameter)(rect 288 -64 388 16))
)
