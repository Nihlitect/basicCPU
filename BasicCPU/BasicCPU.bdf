(text "OUT TO SSD - set EN to load data from bus" (rect 1520 -160 1767 -147)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Output goes directly to the instruction register" (rect 176 -40 445 -27)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Chihab Chamkhi, Vishaal Chopra, Xavier Curr, Afeef Ahmed" (rect -264 -1056 132 -1043)(font "Cascadia Code" (color 0 111 0)(font_size 8)))
(text "This is where we fetch instruction obv. " (rect 56 -800 339 -787)(font "Cascadia Code" (color 0 111 0)(font_size 8)))
(text "We write program in the RAM. PC addresses the ram" (rect 176 -56 481 -43)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Curtin University" (rect -264 -1168 -144 -1155)(font "Cascadia Code" (color 0 111 0)(font_size 8)))
(text "Date: 13/09/2026 version: 1.0 " (rect -264 -1096 -17 -1082)(font "Cascadia Mono" (font_size 9)))
(text "By group 10:" (rect -264 -1072 -180 -1059)(font "Cascadia Code" (color 0 111 0)(font_size 8)))
(text "CMPE4003 - CPU and GPU Architectures" (rect -264 -1152 118 -1133)(font "Cascadia Code" (color 95 0 143)(font_size 12)))
(text "DE/EX" (rect 1096 -1136 1183 -1117)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
(text "EX/WB" (rect 2136 -1136 2224 -1117)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
(text "WRITEBACK" (rect 2400 -1016 2546 -997)(font "AniMe Vision - MB_EN" (color 171 212 36)(font_size 12)))
(text "MEMORY" (rect -80 -256 29 -237)(font "AniMe Vision - MB_EN" (color 214 0 161)(font_size 12)))
(text "DECODE" (rect 664 -1136 764 -1117)(font "AniMe Vision - MB_EN" (color 0 133 195)(font_size 12)))
(text "'nop' feed" (rect 208 -712 264 -699)(font "DejaVu Sans Condensed" (font_size 8)))
(text "doesnt need to be zeroed" (rect 200 -424 346 -411)(font "DejaVu Sans Condensed" (font_size 8)))
(text "has no effect if 'nop'" (rect 200 -440 316 -427)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Disable EN of 'flagRegisters' for 1cycle when CMP is called" (rect 2080 -1192 2416 -1179)(font "DejaVu Sans Condensed" (font_size 8)))
(text "This will allow it to hold onto the flags for any proceeding BR instructions " (rect 2064 -1176 2488 -1163)(font "DejaVu Sans Condensed" (font_size 8)))
(text "WB/FE" (rect -296 -824 -210 -805)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
(text "FETCH" (rect 56 -824 139 -805)(font "AniMe Vision - MB_EN" (color 85 85 255)(font_size 12)))
(text "IF/ID" (rect 376 -824 439 -805)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
(text "EXECUTE" (rect 1424 -1016 1543 -997)(font "AniMe Vision - MB_EN" (color 0 170 127)(font_size 12)))
(text "Select IMM or ALUOUT" (rect 2432 -560 2564 -547)(font "DejaVu Sans Condensed" (font_size 8)))
(text "ALUI: IM+EXO'" (rect 1744 -1128 1830 -1115)(font "DejaVu Sans Condensed" (color 85 0 255)(font_size 8)))
(text "ALU: IM' +EXO'" (rect 1744 -1112 1833 -1099)(font "DejaVu Sans Condensed" (color 85 0 255)(font_size 8)))
(text "SW: EXO" (rect 1744 -1144 1794 -1131)(font "DejaVu Sans Condensed" (color 85 0 255)(font_size 8)))
(text "IM -> ImmBSel" (rect 1848 -1136 1936 -1123)(font "DejaVu Sans Condensed" (font_size 8)))
(text "EXO -> sel_EX_out" (rect 1848 -1112 1956 -1099)(font "DejaVu Sans Condensed" (font_size 8)))
(text "connection:" (rect 1848 -1152 1914 -1139)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Forwarding output" (rect 1568 -472 1674 -459)(font "DejaVu Sans Condensed" (font_size 8)))
(text "CMP: FI + func(A-B)" (rect 1744 -1160 1858 -1147)(font "DejaVu Sans Condensed" (color 85 0 255)(font_size 8)))
(text "thus enabling Control Unit to use when not in priority" (rect 720 104 1026 117)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Branch has priority so it chooses -- By default it is disabled" (rect 720 88 1059 101)(font "DejaVu Sans Condensed" (font_size 8)))
(text "regardless there shouldnt be any instruction in DECODE, when" (rect 720 120 1081 133)(font "DejaVu Sans Condensed" (font_size 8)))
(text "branch is in writeback (PIPELINE SHOULD BE FLUSHED)" (rect 720 136 1039 149)(font "DejaVu Sans Condensed" (font_size 8)))
(text "JMP, JAL, JR will be controlled by the Decode stage " (rect -248 -800 47 -787)(font "DejaVu Sans Condensed" (font_size 8)))
(text "so that subsequent instructions, are immediately" (rect -248 -784 36 -771)(font "DejaVu Sans Condensed" (font_size 8)))
(text "inserted into the pipline, with no \"bubbles\"." (rect -304 -768 -53 -755)(font "DejaVu Sans Condensed" (font_size 8)))
(text "the Decode stage follows the fetch stage." (rect -304 -752 -66 -739)(font "DejaVu Sans Condensed" (font_size 8)))
(text "address" (rect 2384 -584 2428 -571)(font "DejaVu Sans Condensed" (font_size 8)))
(text "executed twice, but even so since its deterministic, it should" (rect 904 -1312 1253 -1299)(font "DejaVu Sans Condensed" (font_size 8)))
(text "stalling later stages has no effect, the instruction would be " (rect 904 -1328 1246 -1315)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Inputs to stall a particular stage of the pipline." (rect 904 -1360 1170 -1347)(font "DejaVu Sans Condensed" (font_size 8)))
(text "PIPELINED CPU DESIGN" (rect -264 -1144 357 -1099)(font "AniMe Vision - MB_EN" (color 170 0 255)(font_size 28)))
(text "not create any problems." (rect 904 -1296 1049 -1283)(font "DejaVu Sans Condensed" (font_size 8)))
(text "BRI" (rect 2656 -1072 2676 -1059)(font "DejaVu Sans Condensed" (font_size 8)))
(text "REG_ENI" (rect 2600 -1088 2649 -1075)(font "DejaVu Sans Condensed" (font_size 8)))
(text "MEM_WE" (rect 2600 -1104 2653 -1091)(font "DejaVu Sans Condensed" (font_size 8)))
(text "SSD_ENI" (rect 2600 -1072 2648 -1059)(font "DejaVu Sans Condensed" (font_size 8)))
(text "ImmSel" (rect 2656 -1088 2700 -1075)(font "DejaVu Sans Condensed" (font_size 8)))
(text "MemSel" (rect 2656 -1104 2703 -1091)(font "DejaVu Sans Condensed" (font_size 8)))
(text "IF we load in a JMP or JAL or JR instruction, then we can directly execute it in this stage" (rect 648 -1184 1149 -1171)(font "DejaVu Sans Condensed" (font_size 8)))
(text "to prevent any bubbles or stalls in the pipeline." (rect 648 -1168 920 -1155)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Its a given then that any preceding stages are also stalled," (rect 904 -1344 1242 -1331)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Goes into SSD, MEMORY" (rect 2752 -576 2895 -563)(font "DejaVu Sans Condensed" (font_size 8)))
(text "FOR HALT" (rect 472 -1128 532 -1115)(font "DejaVu Sans Condensed" (font_size 8)))
