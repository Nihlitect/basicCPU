(text "Chihab Chamkhi, Vishaal Chopra, Xavier Curr, Afeef Ahmed" (rect -424 -1056 -28 -1043)(font "Cascadia Code" (color 0 111 0)(font_size 8)))
(text "Curtin University" (rect -424 -1168 -304 -1155)(font "Cascadia Code" (color 0 111 0)(font_size 8)))
(text "Date: 13/09/2026 version: 1.0 " (rect -424 -1096 -177 -1082)(font "Cascadia Mono" (font_size 9)))
(text "By group 10:" (rect -416 -1088 -332 -1075)(font "Cascadia Code" (color 0 111 0)(font_size 8)))
(text "CMPE4003 - CPU and GPU Architectures" (rect -424 -1152 -42 -1133)(font "Cascadia Code" (color 95 0 143)(font_size 12)))
(text "DE/EX" (rect 1136 -1136 1223 -1117)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
(text "EX/WB" (rect 2056 -1136 2144 -1117)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
(text "WRITEBACK" (rect 2320 -1024 2466 -1005)(font "AniMe Vision - MB_EN" (color 171 212 36)(font_size 12)))
(text "DECODE" (rect 504 -1136 604 -1117)(font "AniMe Vision - MB_EN" (color 0 133 195)(font_size 12)))
(text "'nop' feed" (rect 8 -624 64 -611)(font "DejaVu Sans Condensed" (font_size 8)))
(text "doesnt need to be zeroed" (rect 248 -448 394 -435)(font "DejaVu Sans Condensed" (font_size 8)))
(text "has no effect if 'nop'" (rect 248 -464 364 -451)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Disable EN of 'flagRegisters' for 1cycle when CMP is called" (rect 2000 -1192 2336 -1179)(font "DejaVu Sans Condensed" (font_size 8)))
(text "This will allow it to hold onto the flags for any proceeding BR instructions " (rect 1984 -1176 2408 -1163)(font "DejaVu Sans Condensed" (font_size 8)))
(text "WB/FE" (rect -400 -824 -314 -805)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
(text "FETCH" (rect -136 -824 -53 -805)(font "AniMe Vision - MB_EN" (color 85 85 255)(font_size 12)))
(text "IF/ID" (rect 216 -824 279 -805)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
(text "EXECUTE" (rect 1424 -1016 1543 -997)(font "AniMe Vision - MB_EN" (color 0 170 127)(font_size 12)))
(text "ALUI: IM+EXO'" (rect 1456 -1288 1542 -1275)(font "DejaVu Sans Condensed" (color 85 0 255)(font_size 8)))
(text "ALU: IM' +EXO'" (rect 1456 -1272 1545 -1259)(font "DejaVu Sans Condensed" (color 85 0 255)(font_size 8)))
(text "SW: EXO" (rect 1456 -1304 1506 -1291)(font "DejaVu Sans Condensed" (color 85 0 255)(font_size 8)))
(text "IM -> ImmBSel" (rect 1560 -1296 1648 -1283)(font "DejaVu Sans Condensed" (font_size 8)))
(text "EXO -> sel_EX_out" (rect 1560 -1272 1668 -1259)(font "DejaVu Sans Condensed" (font_size 8)))
(text "connection:" (rect 1560 -1312 1626 -1299)(font "DejaVu Sans Condensed" (font_size 8)))
(text "CMP: FI + func(A-B)" (rect 1456 -1320 1570 -1307)(font "DejaVu Sans Condensed" (color 85 0 255)(font_size 8)))
(text "JMP, JAL, JR will be controlled by the Decode stage " (rect -400 -800 -105 -787)(font "DejaVu Sans Condensed" (font_size 8)))
(text "so that subsequent instructions, are immediately" (rect -400 -784 -116 -771)(font "DejaVu Sans Condensed" (font_size 8)))
(text "inserted into the pipline, with no \"bubbles\"." (rect -400 -768 -149 -755)(font "DejaVu Sans Condensed" (font_size 8)))
(text "the Decode stage follows the fetch stage." (rect -400 -752 -162 -739)(font "DejaVu Sans Condensed" (font_size 8)))
(text "executed twice, but even so since its deterministic, it should" (rect 744 -1304 1093 -1291)(font "DejaVu Sans Condensed" (font_size 8)))
(text "stalling later stages has no effect, the instruction would be " (rect 744 -1320 1086 -1307)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Inputs to stall a particular stage of the pipline." (rect 744 -1352 1010 -1339)(font "DejaVu Sans Condensed" (font_size 8)))
(text "PIPELINED CPU DESIGN" (rect -424 -1144 197 -1099)(font "AniMe Vision - MB_EN" (color 170 0 255)(font_size 28)))
(text "not create any problems." (rect 744 -1288 889 -1275)(font "DejaVu Sans Condensed" (font_size 8)))
(text "BRI" (rect 2576 -1072 2596 -1059)(font "DejaVu Sans Condensed" (font_size 8)))
(text "REG_ENI" (rect 2520 -1088 2569 -1075)(font "DejaVu Sans Condensed" (font_size 8)))
(text "MEM_WE" (rect 2520 -1104 2573 -1091)(font "DejaVu Sans Condensed" (font_size 8)))
(text "SSD_ENI" (rect 2520 -1072 2568 -1059)(font "DejaVu Sans Condensed" (font_size 8)))
(text "ImmSel" (rect 2576 -1088 2620 -1075)(font "DejaVu Sans Condensed" (font_size 8)))
(text "MemSel" (rect 2576 -1104 2623 -1091)(font "DejaVu Sans Condensed" (font_size 8)))
(text "IF we load in a JMP or JAL or JR instruction, then we can directly execute it in this stage" (rect 648 -1184 1149 -1171)(font "DejaVu Sans Condensed" (font_size 8)))
(text "to prevent any bubbles or stalls in the pipeline." (rect 488 -1168 760 -1155)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Its a given then that any preceding stages are also stalled," (rect 744 -1336 1082 -1323)(font "DejaVu Sans Condensed" (font_size 8)))
(text "FOR HALT" (rect 312 -1152 372 -1139)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Output goes directly to the instruction register" (rect 2496 -160 2765 -147)(font "DejaVu Sans Condensed" (font_size 8)))
(text "We write program in the RAM. PC addresses the ram" (rect 2496 -176 2801 -163)(font "DejaVu Sans Condensed" (font_size 8)))
(text "MEMORY" (rect 2440 -352 2549 -333)(font "AniMe Vision - MB_EN" (color 214 0 161)(font_size 12)))
(text "OUT TO SSD - set EN to load data from bus" (rect 592 -624 839 -611)(font "DejaVu Sans Condensed" (font_size 8)))
(text "rd_or_cond" (rect 1034 -984 1084 -974)(font "DejaVu Sans Condensed" ))
(text "Forwarding output" (rect 562 -568 668 -555)(font "DejaVu Sans Condensed" (font_size 8)))
(text "hazard_feedback" (rect 784 -608 880 -595)(font "DejaVu Sans Condensed" (font_size 8)))
(text "SEVEN SEGMENT DISPLAY" (rect 2376 -528 2698 -509)(font "AniMe Vision - MB_EN" (color 85 0 255)(font_size 12)))
(text "JUMP & BRANCH" (rect 688 -208 885 -189)(font "AniMe Vision - MB_EN" (color 0 170 0)(font_size 12)))
(text "Goes into SSD, MEMORY and" (rect 2680 -864 2847 -851)(font "DejaVu Sans Condensed" (font_size 8)))
(text "REGISTER FILE" (rect 2704 -848 2790 -835)(font "DejaVu Sans Condensed" (font_size 8)))
(text "into shared data Bus" (rect 2568 -960 2687 -947)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Input from Imm16, ALU Output, Switches or Memory" (rect 2568 -976 2872 -963)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Select SW or ALU out" (rect 2440 -976 2562 -963)(font "DejaVu Sans Condensed" (font_size 8)))
(text "SWITCH INPUT" (rect 1432 -1160 1604 -1141)(font "AniMe Vision - MB_EN" (color 230 115 172)(font_size 12)))
(text "Even though not shown here if accessing memory from RAM we do it in this stage" (rect 1424 -168 1896 -155)(font "DejaVu Sans Condensed" (font_size 8)))
(text "so data is prepared for WB stage" (rect 1424 -152 1612 -139)(font "DejaVu Sans Condensed" (font_size 8)))
(text "FEX -> Enable Forwarding for Execute" (rect 1112 -1272 1331 -1259)(font "DejaVu Sans Condensed" (font_size 8)))
(text "FWB -> Enable Forwarding for writeback" (rect 1112 -1288 1346 -1275)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Select MEM out" (rect 2448 -832 2537 -819)(font "DejaVu Sans Condensed" (font_size 8)))
(text "SWO" (rect 1928 -984 1956 -971)(font "DejaVu Sans Condensed" (font_size 8)))
(text "EXO" (rect 1928 -968 1952 -955)(font "DejaVu Sans Condensed" (font_size 8)))
(text "IMMO" (rect 1928 -952 1962 -939)(font "DejaVu Sans Condensed" (font_size 8)))
(text "SHFTO" (rect 1928 -936 1966 -923)(font "DejaVu Sans Condensed" (font_size 8)))
(text "ALUO" (rect 1928 -920 1961 -907)(font "DejaVu Sans Condensed" (font_size 8)))
(text "CONTROL EXECUTE OUTPUT" (rect 1512 -992 1753 -978)(font "AniMe Vision - MB_EN" (font_size 8)))
(text "turn 1 on only:" (rect 1888 -1000 1971 -987)(font "DejaVu Sans Condensed" (font_size 8)))
(text "From Operand: Memory Address" (rect 2080 -584 2268 -571)(font "DejaVu Sans Condensed" (font_size 8)))
