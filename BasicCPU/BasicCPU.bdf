(text "By group 10:" (rect -256 -1144 -172 -1131)(font "Cascadia Code" (color 0 111 0)(font_size 8)))
(text "CMPE4003 - CPU and GPU Architectures" (rect -256 -1224 126 -1205)(font "Cascadia Code" (color 95 0 143)(font_size 12)))
(text "DE/EX" (rect 1136 -1136 1223 -1117)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
