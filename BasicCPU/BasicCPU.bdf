(text "Chihab Chamkhi, Vishaal Chopra, Xavier Curr, Afeef Ahmed" (rect -424 -1056 -28 -1043)(font "Cascadia Code" (color 0 111 0)(font_size 8)))
(text "Curtin University" (rect -424 -1168 -304 -1155)(font "Cascadia Code" (color 0 111 0)(font_size 8)))
(text "Date: 13/09/2026 version: 1.0 " (rect -424 -1096 -177 -1082)(font "Cascadia Mono" (font_size 9)))
(text "By group 10:" (rect -424 -1072 -340 -1059)(font "Cascadia Code" (color 0 111 0)(font_size 8)))
(text "CMPE4003 - CPU and GPU Architectures" (rect -424 -1152 -42 -1133)(font "Cascadia Code" (color 95 0 143)(font_size 12)))
(text "DE/EX" (rect 1136 -1136 1223 -1117)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
(text "EX/WB" (rect 2136 -1136 2224 -1117)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
(text "WRITEBACK" (rect 2400 -1024 2546 -1005)(font "AniMe Vision - MB_EN" (color 171 212 36)(font_size 12)))
(text "DECODE" (rect 504 -1136 604 -1117)(font "AniMe Vision - MB_EN" (color 0 133 195)(font_size 12)))
(text "'nop' feed" (rect 8 -624 64 -611)(font "DejaVu Sans Condensed" (font_size 8)))
(text "doesnt need to be zeroed" (rect 248 -448 394 -435)(font "DejaVu Sans Condensed" (font_size 8)))
(text "has no effect if 'nop'" (rect 248 -464 364 -451)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Disable EN of 'flagRegisters' for 1cycle when CMP is called" (rect 2080 -1192 2416 -1179)(font "DejaVu Sans Condensed" (font_size 8)))
(text "This will allow it to hold onto the flags for any proceeding BR instructions " (rect 2064 -1176 2488 -1163)(font "DejaVu Sans Condensed" (font_size 8)))
(text "WB/FE" (rect -400 -824 -314 -805)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
(text "FETCH" (rect -136 -824 -53 -805)(font "AniMe Vision - MB_EN" (color 85 85 255)(font_size 12)))
(text "IF/ID" (rect 216 -824 279 -805)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
(text "EXECUTE" (rect 1424 -1016 1543 -997)(font "AniMe Vision - MB_EN" (color 0 170 127)(font_size 12)))
(text "ALUI: IM+EXO'" (rect 1432 -1192 1518 -1179)(font "DejaVu Sans Condensed" (color 85 0 255)(font_size 8)))
(text "ALU: IM' +EXO'" (rect 1432 -1176 1521 -1163)(font "DejaVu Sans Condensed" (color 85 0 255)(font_size 8)))
(text "SW: EXO" (rect 1432 -1208 1482 -1195)(font "DejaVu Sans Condensed" (color 85 0 255)(font_size 8)))
(text "IM -> ImmBSel" (rect 1536 -1200 1624 -1187)(font "DejaVu Sans Condensed" (font_size 8)))
(text "EXO -> sel_EX_out" (rect 1536 -1176 1644 -1163)(font "DejaVu Sans Condensed" (font_size 8)))
(text "connection:" (rect 1536 -1216 1602 -1203)(font "DejaVu Sans Condensed" (font_size 8)))
(text "CMP: FI + func(A-B)" (rect 1432 -1224 1546 -1211)(font "DejaVu Sans Condensed" (color 85 0 255)(font_size 8)))
(text "JMP, JAL, JR will be controlled by the Decode stage " (rect -400 -800 -105 -787)(font "DejaVu Sans Condensed" (font_size 8)))
(text "so that subsequent instructions, are immediately" (rect -400 -784 -116 -771)(font "DejaVu Sans Condensed" (font_size 8)))
(text "inserted into the pipline, with no \"bubbles\"." (rect -400 -768 -149 -755)(font "DejaVu Sans Condensed" (font_size 8)))
(text "the Decode stage follows the fetch stage." (rect -400 -752 -162 -739)(font "DejaVu Sans Condensed" (font_size 8)))
(text "address" (rect 2440 -736 2484 -723)(font "DejaVu Sans Condensed" (font_size 8)))
(text "executed twice, but even so since its deterministic, it should" (rect 744 -1304 1093 -1291)(font "DejaVu Sans Condensed" (font_size 8)))
(text "stalling later stages has no effect, the instruction would be " (rect 744 -1320 1086 -1307)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Inputs to stall a particular stage of the pipline." (rect 744 -1352 1010 -1339)(font "DejaVu Sans Condensed" (font_size 8)))
(text "PIPELINED CPU DESIGN" (rect -424 -1144 197 -1099)(font "AniMe Vision - MB_EN" (color 170 0 255)(font_size 28)))
(text "not create any problems." (rect 744 -1288 889 -1275)(font "DejaVu Sans Condensed" (font_size 8)))
(text "BRI" (rect 2656 -1072 2676 -1059)(font "DejaVu Sans Condensed" (font_size 8)))
(text "REG_ENI" (rect 2600 -1088 2649 -1075)(font "DejaVu Sans Condensed" (font_size 8)))
(text "MEM_WE" (rect 2600 -1104 2653 -1091)(font "DejaVu Sans Condensed" (font_size 8)))
(text "SSD_ENI" (rect 2600 -1072 2648 -1059)(font "DejaVu Sans Condensed" (font_size 8)))
(text "ImmSel" (rect 2656 -1088 2700 -1075)(font "DejaVu Sans Condensed" (font_size 8)))
(text "MemSel" (rect 2656 -1104 2703 -1091)(font "DejaVu Sans Condensed" (font_size 8)))
(text "IF we load in a JMP or JAL or JR instruction, then we can directly execute it in this stage" (rect 648 -1184 1149 -1171)(font "DejaVu Sans Condensed" (font_size 8)))
(text "to prevent any bubbles or stalls in the pipeline." (rect 488 -1168 760 -1155)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Its a given then that any preceding stages are also stalled," (rect 744 -1336 1082 -1323)(font "DejaVu Sans Condensed" (font_size 8)))
(text "FOR HALT" (rect 312 -1152 372 -1139)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Output goes directly to the instruction register" (rect 2576 -160 2845 -147)(font "DejaVu Sans Condensed" (font_size 8)))
(text "We write program in the RAM. PC addresses the ram" (rect 2576 -176 2881 -163)(font "DejaVu Sans Condensed" (font_size 8)))
(text "MEMORY" (rect 2520 -352 2629 -333)(font "AniMe Vision - MB_EN" (color 214 0 161)(font_size 12)))
(text "OUT TO SSD - set EN to load data from bus" (rect 592 -384 839 -371)(font "DejaVu Sans Condensed" (font_size 8)))
(text "rd_or_cond" (rect 1034 -984 1084 -974)(font "DejaVu Sans Condensed" ))
(text "Forwarding output" (rect 914 -760 1020 -747)(font "DejaVu Sans Condensed" (font_size 8)))
(text "hazard_feedback" (rect 880 -384 976 -371)(font "DejaVu Sans Condensed" (font_size 8)))
(text "SEVEN SEGMENT DISPLAY" (rect 2456 -528 2778 -509)(font "AniMe Vision - MB_EN" (color 85 0 255)(font_size 12)))
(text "JUMP & BRANCH" (rect 640 -312 837 -293)(font "AniMe Vision - MB_EN" (color 0 170 0)(font_size 12)))
(text "SWITCH IN" (rect 2312 -1312 2373 -1299)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Goes into SSD, MEMORY and" (rect 2760 -864 2927 -851)(font "DejaVu Sans Condensed" (font_size 8)))
(text "REGISTER FILE" (rect 2784 -848 2870 -835)(font "DejaVu Sans Condensed" (font_size 8)))
(text "into shared data Bus" (rect 2648 -944 2767 -931)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Input from Imm16, ALU Output, Switches or Memory" (rect 2648 -960 2952 -947)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Select IMM or MEM out" (rect 2504 -784 2637 -771)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Select SW or ALU out" (rect 2520 -976 2642 -963)(font "DejaVu Sans Condensed" (font_size 8)))
(text "From Operand" (rect 2192 -264 2275 -251)(font "DejaVu Sans Condensed" (font_size 8)))
(text "From [PC+1]" (rect 2192 -144 2267 -131)(font "DejaVu Sans Condensed" (font_size 8)))
