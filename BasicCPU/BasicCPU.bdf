(text "Chihab Chamkhi, Vishaal Chopra, Xavier Curr, Afeef Ahmed" (rect -424 -1056 -28 -1043)(font "Cascadia Code" (color 0 111 0)(font_size 8)))
(text "Curtin University" (rect -424 -1168 -304 -1155)(font "Cascadia Code" (color 0 111 0)(font_size 8)))
(text "Date: 13/09/2026 version: 1.0 " (rect -424 -1096 -177 -1082)(font "Cascadia Mono" (font_size 9)))
(text "By group 10:" (rect -424 -1072 -340 -1059)(font "Cascadia Code" (color 0 111 0)(font_size 8)))
(text "CMPE4003 - CPU and GPU Architectures" (rect -424 -1152 -42 -1133)(font "Cascadia Code" (color 95 0 143)(font_size 12)))
(text "DE/EX" (rect 1136 -1136 1223 -1117)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
(text "EX/WB" (rect 2056 -1136 2144 -1117)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
(text "WRITEBACK" (rect 2320 -1024 2466 -1005)(font "AniMe Vision - MB_EN" (color 171 212 36)(font_size 12)))
(text "DECODE" (rect 504 -1136 604 -1117)(font "AniMe Vision - MB_EN" (color 0 133 195)(font_size 12)))
(text "'nop' feed" (rect -8 -624 48 -611)(font "DejaVu Sans Condensed" (font_size 8)))
(text "doesnt need to be zeroed" (rect 248 -448 394 -435)(font "DejaVu Sans Condensed" (font_size 8)))
(text "has no effect if 'nop'" (rect 248 -464 364 -451)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Disable EN of 'flagRegisters' for 1cycle when CMP is called" (rect 2000 -1192 2336 -1179)(font "DejaVu Sans Condensed" (font_size 8)))
(text "This will allow it to hold onto the flags for any proceeding BR instructions " (rect 1984 -1176 2408 -1163)(font "DejaVu Sans Condensed" (font_size 8)))
(text "WB/FE" (rect -400 -824 -314 -805)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
(text "FETCH" (rect -136 -824 -53 -805)(font "AniMe Vision - MB_EN" (color 85 85 255)(font_size 12)))
(text "IF/ID" (rect 216 -824 279 -805)(font "AniMe Vision - MB_EN" (color 0 0 127)(font_size 12)))
(text "EXECUTE" (rect 1424 -1024 1543 -1005)(font "AniMe Vision - MB_EN" (color 0 170 127)(font_size 12)))
(text "JMP, JAL, JR will be controlled by the Decode stage " (rect -408 -800 -113 -787)(font "DejaVu Sans Condensed" (font_size 8)))
(text "so that subsequent instructions, are immediately" (rect -408 -784 -124 -771)(font "DejaVu Sans Condensed" (font_size 8)))
(text "inserted into the pipline, with no \"bubbles\"." (rect -408 -768 -157 -755)(font "DejaVu Sans Condensed" (font_size 8)))
(text "the Decode stage follows the fetch stage." (rect -408 -752 -170 -739)(font "DejaVu Sans Condensed" (font_size 8)))
(text "executed twice, but even so since its deterministic, it should" (rect 744 -1288 1093 -1275)(font "DejaVu Sans Condensed" (font_size 8)))
(text "stalling later stages has no effect, the instruction would be " (rect 744 -1304 1086 -1291)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Inputs to stall a particular stage of the pipline." (rect 744 -1336 1010 -1323)(font "DejaVu Sans Condensed" (font_size 8)))
(text "PIPELINED CPU DESIGN" (rect -424 -1144 197 -1099)(font "AniMe Vision - MB_EN" (color 170 0 255)(font_size 28)))
(text "not create any problems." (rect 744 -1272 889 -1259)(font "DejaVu Sans Condensed" (font_size 8)))
(text "IF we load in a JMP or JAL or JR instruction, then we can directly execute it in this stage" (rect 488 -1184 989 -1171)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Its a given then that any preceding stages are also stalled," (rect 744 -1320 1082 -1307)(font "DejaVu Sans Condensed" (font_size 8)))
(text "FOR HALT" (rect 336 -1128 396 -1115)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Output goes directly to the instruction register" (rect 2496 -160 2765 -147)(font "DejaVu Sans Condensed" (font_size 8)))
(text "We write program in the RAM. PC addresses the ram" (rect 2496 -176 2801 -163)(font "DejaVu Sans Condensed" (font_size 8)))
(text "MEMORY" (rect 2440 -352 2549 -333)(font "AniMe Vision - MB_EN" (color 214 0 161)(font_size 12)))
(text "rd_or_cond" (rect 1034 -984 1084 -974)(font "DejaVu Sans Condensed" ))
(text "Forwarding output" (rect 506 -552 612 -539)(font "DejaVu Sans Condensed" (font_size 8)))
(text "SEVEN SEGMENT DISPLAY" (rect 2376 -528 2698 -509)(font "AniMe Vision - MB_EN" (color 85 0 255)(font_size 12)))
(text "JUMP & BRANCH" (rect 800 -192 997 -173)(font "AniMe Vision - MB_EN" (color 0 170 0)(font_size 12)))
(text "Goes into SSD, MEMORY and" (rect 2512 -752 2679 -739)(font "DejaVu Sans Condensed" (font_size 8)))
(text "REGISTER FILE" (rect 2536 -736 2622 -723)(font "DejaVu Sans Condensed" (font_size 8)))
(text "SWITCH INPUT" (rect 1448 -1192 1620 -1173)(font "AniMe Vision - MB_EN" (color 230 115 172)(font_size 12)))
(text "Even though not shown here if accessing memory from RAM we do it in this stage" (rect 1424 -168 1896 -155)(font "DejaVu Sans Condensed" (font_size 8)))
(text "so data is prepared for WB stage" (rect 1424 -152 1612 -139)(font "DejaVu Sans Condensed" (font_size 8)))
(text "SWO" (rect 1928 -984 1956 -971)(font "DejaVu Sans Condensed" (font_size 8)))
(text "EXO" (rect 1928 -968 1952 -955)(font "DejaVu Sans Condensed" (font_size 8)))
(text "IMMO" (rect 1928 -952 1962 -939)(font "DejaVu Sans Condensed" (font_size 8)))
(text "SHFTO" (rect 1928 -936 1966 -923)(font "DejaVu Sans Condensed" (font_size 8)))
(text "ALUO" (rect 1928 -920 1961 -907)(font "DejaVu Sans Condensed" (font_size 8)))
(text "turn 1 on only:" (rect 1888 -1000 1971 -987)(font "DejaVu Sans Condensed" (font_size 8)))
(text "LED OUTPUTS" (rect 2944 -648 3118 -629)(font "AniMe Vision - MB_EN" (color 255 85 0)(font_size 12)))
(text "Select MEM out" (rect 1496 -712 1585 -699)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Seven Segment Display" (rect 2944 -864 3266 -845)(font "AniMe Vision - MB_EN" (color 170 170 0)(font_size 12)))
(text "status indicatorS" (rect 2928 -904 3188 -885)(font "AniMe Vision - MB_EN" (color 227 23 78)(font_size 12)))
(text "pass destination registers of following stages" (rect 832 -584 1091 -571)(font "DejaVu Sans Condensed" (font_size 8)))
(text "device enable write bits:" (rect 2464 -848 2605 -835)(font "DejaVu Sans Condensed" (font_size 8)))
(text "DEVICE[0] - Register enable write" (rect 2472 -832 2667 -819)(font "DejaVu Sans Condensed" (font_size 8)))
(text "DEVICE[1] - RAM enable write" (rect 2472 -816 2646 -803)(font "DejaVu Sans Condensed" (font_size 8)))
(text "DEVICE[2] - SSD enable write" (rect 2472 -800 2643 -787)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Operands give Memory Address to" (rect 2080 -560 2280 -547)(font "DejaVu Sans Condensed" (font_size 8)))
(text "* Memory here is accessed in decode, after a clock cycle the output is ready to be used in execute stage" (rect 2360 -120 2961 -107)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Flags:" (rect 2056 -120 2090 -107)(font "DejaVu Sans Condensed" (font_size 8)))
(text "flag[1] - negative" (rect 2056 -88 2156 -75)(font "DejaVu Sans Condensed" (font_size 8)))
(text "flag[2] - zero" (rect 2056 -72 2130 -59)(font "DejaVu Sans Condensed" (font_size 8)))
(text "flag[0] - overflow" (rect 2056 -104 2155 -91)(font "DejaVu Sans Condensed" (font_size 8)))
(text "flag[3] - carry" (rect 2056 -56 2135 -43)(font "DejaVu Sans Condensed" (font_size 8)))
(text "They use same JMP signal on PC" (rect 800 -168 986 -155)(font "DejaVu Sans Condensed" (font_size 8)))
(text "HAZARD FEEDBACK" (rect 504 -584 748 -565)(font "AniMe Vision - MB_EN" (color 0 85 0)(font_size 12)))
(text "[OPCODE] OR HALT" (rect 552 -1000 668 -987)(font "DejaVu Sans Condensed" (font_size 8)))
(text "feed into Control unit." (rect 552 -984 678 -971)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Feeding Halt creates" (rect 552 -968 671 -955)(font "DejaVu Sans Condensed" (font_size 8)))
(text "feedback loop of halt" (rect 552 -952 672 -939)(font "DejaVu Sans Condensed" (font_size 8)))
(text "instructions." (rect 552 -936 622 -923)(font "DejaVu Sans Condensed" (font_size 8)))
(text "to prevent/Minimise any bubbles or stalls in the pipeline." (rect 488 -1168 817 -1155)(font "DejaVu Sans Condensed" (font_size 8)))
(text "* Memory is accessed here, after a clock cycle " (rect 1128 -1176 1398 -1163)(font "DejaVu Sans Condensed" (font_size 8)))
(text "the output is ready to be used in execute stage" (rect 1136 -1160 1408 -1147)(font "DejaVu Sans Condensed" (font_size 8)))
(text "FWWB -> Enable Forwarding for writeback" (rect 1144 -1360 1390 -1347)(font "DejaVu Sans Condensed" (font_size 8)))
(text "FWEX -> Enable Forwarding for Execute" (rect 1144 -1344 1375 -1331)(font "DejaVu Sans Condensed" (font_size 8)))
(text "Funnel EXECUTE OUTPUT" (rect 1440 -992 1664 -978)(font "AniMe Vision - MB_EN" (color 170 0 127)(font_size 8)))
(text "write back stage" (rect 2080 -544 2175 -531)(font "DejaVu Sans Condensed" (font_size 8)))
(text "This stage doesnt do much anymore lmao pretty useless but whatever" (rect 2336 -1048 2744 -1035)(font "DejaVu Sans Condensed" (font_size 8)))
