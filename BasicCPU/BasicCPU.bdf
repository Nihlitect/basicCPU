(text "Chihab Chamkhi, Vishaal Chopra, Xavier Curr, Afeef Ahmed" (rect -264 -1056 132 -1043)(font "Cascadia Code" (color 0 111 0)(font_size 8)))
(text "This is where we fetch instruction obv. " (rect 48 -800 331 -787)(font "Cascadia Code" (color 0 111 0)(font_size 8)))
